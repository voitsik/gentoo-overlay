From d6e6ddcb90d506d1fbe5291a3c63fa63b3b64f9d Mon Sep 17 00:00:00 2001
From: Petr Voytsik <voitsik@asc.rssi.ru>
Date: Wed, 2 Sep 2026 17:44:30 +0300
Subject: [PATCH] Manually set version in command line via CASACPP_VERSION
 variable

---
 CMakeLists.txt | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4d3cae2326..745b9b557a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -24,10 +24,10 @@
 # Minimum cmake required version
 cmake_minimum_required(VERSION 3.12)
 
-execute_process(COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/../../scripts/version
-    WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
-    OUTPUT_VARIABLE CASACPP_VERSION)
-string(REGEX MATCH "([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)" CASACPP_VERSION ${CASACPP_VERSION})
+# execute_process(COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/../../scripts/version
+#     WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
+#     OUTPUT_VARIABLE CASACPP_VERSION)
+# string(REGEX MATCH "([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)" CASACPP_VERSION ${CASACPP_VERSION})
 message("CASACPP version: " ${CASACPP_VERSION})
 
 project(
